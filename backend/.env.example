# Copy this file to `.env` for local development. Never commit the real `.env`.

ENVIRONMENT=development
DEBUG=true

# SQLAlchemy connection string. Matches the `db` service in docker/docker-compose.yml.
DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory

# A separate database the test suite creates/drops its schema in - never
# points at the same database as DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://inventory:inventory@localhost:5432/inventory_test

# Generate a real value with `openssl rand -hex 32` for anything beyond local dev.
SECRET_KEY=insecure-dev-secret-change-me-00000000000000
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated list of origins allowed to call this API (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Directory uploaded product images are written to, served at /static.
UPLOAD_DIR=uploads

# Directory the trained demand-forecasting model is persisted to (Milestone 12).
ML_MODEL_DIR=ml_artifacts

# Redis connection string, used to cache the dashboard summary (Milestone 17).
# Matches the `redis` service in docker/docker-compose.yml. The app degrades
# gracefully (no caching, no errors) if Redis is unreachable - this is a
# performance optimization, never a hard dependency.
REDIS_URL=redis://localhost:6379/0
# A separate logical DB from REDIS_URL, the same way TEST_DATABASE_URL is a
# separate database - so the test suite's cache flushes never touch a
# dev cache, even though flushing a pure cache is always safe.
TEST_REDIS_URL=redis://localhost:6379/1
# How long the dashboard summary is served from cache before recomputing.
DASHBOARD_CACHE_TTL_SECONDS=30
