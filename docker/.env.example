# Secrets/config for docker-compose.prod.yml. Copy to `.env` in this same
# directory and fill in real values - never commit the real file.
#
# Usage:
#   cp .env.example .env
#   docker compose -f docker-compose.prod.yml up --build -d

# Postgres credentials. POSTGRES_PASSWORD has no default on purpose -
# compose refuses to start without it explicitly set.
POSTGRES_USER=inventory
POSTGRES_PASSWORD=change-me-to-a-real-password
POSTGRES_DB=inventory

# Generate with `openssl rand -hex 32`. Also has no default - anyone who can
# read a shared/default value could forge access tokens.
SECRET_KEY=change-me-to-a-real-secret

ACCESS_TOKEN_EXPIRE_MINUTES=60

# Left empty by default: the frontend calls the backend through nginx's
# same-origin proxy (see frontend/nginx.conf), so no cross-origin caller
# needs allowing unless the API is also meant to be called directly from
# somewhere else (a mobile app, a separate origin, etc).
CORS_ORIGINS=

# The host port the frontend (nginx, listening on 8080 in-container) is
# published on. 80 for a bare-domain deployment; change if something else
# on the host already owns port 80.
FRONTEND_PORT=80
